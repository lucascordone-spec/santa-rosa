{
  "name": "@santa-rosa/sentinel-keeper",
  "version": "1.0.0",
  "description": "Autonomous Volume Sentinel & Anti-Liquidation MEV Keeper Bot on Base L2",
  "type": "module",
  "main": "sentinel.mjs",
  "bin": {
    "sentinel-keeper": "./sentinel.mjs"
  },
  "scripts": {
    "start": "node sentinel.mjs",
    "scan": "node sentinel.mjs --dry-run",
    "monitor": "node sentinel.mjs --poll --interval 10"
