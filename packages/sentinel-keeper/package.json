  "dependencies": {
    "viem": "^2.21.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "defi",
    "base-l2",
    "keeper-bot",
    "mev",
    "morpho-blue",
    "mcp",
    "anti-liquidation",
    "revenue-share",
    "flash-loans"
  ],
  "author": "Santa Rosa Protocol",
  "license": "MIT"
}
